            @endpersist

            @fluxScripts
            <script>
                function updateConnectionStatus() {
                    const dot = document.getElementById('status-dot');
                    const text = document.getElementById('status-text');
                    if (navigator.onLine) {
                        dot.classList.remove('bg-red-500', 'bg-yellow-500');
                        dot.classList.add('bg-green-500');
                        text.textContent = 'Online';
                    } else {
                        dot.classList.remove('bg-green-500', 'bg-yellow-500');
                        dot.classList.add('bg-red-500');
                        text.textContent = 'Offline';
                    }
                }
                window.addEventListener('online', updateConnectionStatus);
                window.addEventListener('offline', updateConnectionStatus);
                updateConnectionStatus();

                async function checkQueuedScans() {
                    try {
                        const response = await fetch('/staff/api/scans/today', {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        });
                        const data = await response.json();
                        const count = data.scans?.filter(s => s.sync_status === 'pending').length || 0;
                        const counter = document.getElementById('scan-counter');
                        const countSpan = document.getElementById('scan-count');
                        if (counter && countSpan) {
                            if (count > 0) {
                                counter.classList.remove('hidden');
                                counter.classList.add('flex');
                                countSpan.textContent = count;
                            } else {
                                counter.classList.add('hidden');
                                counter.classList.remove('flex');
                            }
                        }
                    } catch (e) {
                        console.error('Failed to check queued scans', e);
                    }
                }

                document.getElementById('logout-btn')?.addEventListener('click', async (e) => {
                    e.preventDefault();
                    await checkQueuedScans();
                    const count = document.getElementById('scan-count')?.textContent || '0';
                    if (count > 0) {
                        if (confirm(`You have ${count} scan(s) waiting to synchronize. Do you want to sync now before logging out?`)) {
                            const form = document.getElementById('logout-form');
                            form.submit();
                        }
                    } else {
                        const form = document.getElementById('logout-form');
                        form.submit();
                    }
                });

                checkQueuedScans();
            </script>
        </flux:main>
    </body>
</html>
